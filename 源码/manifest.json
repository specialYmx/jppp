{
  "manifest_version": 3,
  "name": "ChatGPT Session 提取器",
  "version": "2.0",
  "description": "点击一键提取并下载 ChatGPT 账号配置 JSON",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://chatgpt.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "提取 Session"
  }
}
